+```typescript
+import { prisma } from '@/lib/prisma'
+import { startOfMonth, endOfMonth, subMonths, startOfYear, endOfYear } from 'date-fns'
+
+export async function getKPIs() {
+  const now = new Date()
+  const thisMonthStart = startOfMonth(now)
+  const thisMonthEnd = endOfMonth(now)
+  const lastMonthStart = startOfMonth(subMonths(now, 1))
+  const lastMonthEnd = endOfMonth(subMonths(now, 1))
+
+  // Total Bikes in Stock
+  const bikesThisMonth = await prisma.vehicle.aggregate({
+    where: { type: 'BIKE' },
+    _sum: { quantity: true },
+  })
+  const bikesLastMonth = await prisma.vehicle.aggregate({
+    where: { type: 'BIKE' },
+    _sum: { quantity: true },
+  })
+  const bikesInStock = bikesThisMonth._sum.quantity || 0
+  const bikesChange = ((bikesInStock - (bikesLastMonth._sum.quantity || 0)) / Math.max(bikesLastMonth._sum.quantity || 1, 1)) * 100
+
+  // Total Scooters in Stock
+  const scootersThisMonth = await prisma.vehicle.aggregate({
+    where: { type: 'SCOOTER' },
+    _sum: { quantity: true },
+  })
+  const scootersLastMonth = await prisma.vehicle.aggregate({
+    where: { type: 'SCOOTER' },
+    _sum: { quantity: true },
+  })
+  const scootersInStock = scootersThisMonth._sum.quantity || 0
+  const scootersChange = ((scootersInStock - (scootersLastMonth._sum.quantity || 0)) / Math.max(scootersLastMonth._sum.quantity || 1, 1)) * 100
+
+  // Total Parts in Stock
+  const partsThisMonth = await prisma.part.aggregate({
+    where: {},
+    _sum: { quantity: true },
+  })
+  const partsLastMonth = await prisma.part.aggregate({
+    where: {},
+    _sum: { quantity: true },
+  })
+  const partsInStock = partsThisMonth._sum.quantity || 0
+  const partsChange = ((partsInStock - (partsLastMonth._sum.quantity || 0)) / Math.max(partsLastMonth._sum.quantity || 1, 1)) * 100
+
+  // Total Revenue (from completed orders this month)
+  const revenueThisMonth = await prisma.order.aggregate({
+    where: {
+      status: 'PAID',
+      createdAt: {
+        gte: thisMonthStart,
+        lte: thisMonthEnd,
+      },
+    },
+    _sum: { totalAmount: true },
+  })
+  const revenueLastMonth = await prisma.order.aggregate({
+    where: {
+      status: 'PAID',
+      createdAt: {
+        gte: lastMonthStart,
+        lte: lastMonthEnd,
+      },
+    },
+    _sum: { totalAmount: true },
+  })
+  const totalRevenue = revenueThisMonth._sum.totalAmount || 0
+  const revenueChange = ((totalRevenue - (revenueLastMonth._sum.totalAmount || 0)) / Math.max(revenueLastMonth._sum.totalAmount || 1, 1)) * 100
+
+  return {
+    totalRevenue,
+    revenueChange,
+    bikesInStock,
+    bikesChange,
+    scootersInStock,
+    scootersChange,
+    partsInStock,
+    partsChange,
+  }
+}
+
+export async function getMonthlyRevenue(months: number = 12) {
+  const now = new Date()
+  const data = []
+
+  for (let i = months - 1; i >= 0; i--) {
+    const date = subMonths(now, i)
+    const monthStart = startOfMonth(date)
+    const monthEnd = endOfMonth(date)
+
+    const revenue = await prisma.order.aggregate({
+      where: {
+        status: 'PAID',
+        createdAt: {
+          gte: monthStart,
+          lte: monthEnd,
+        },
+      },
+      _sum: { totalAmount: true },
+    })
+
+    data.push({
+      month: date.toLocaleDateString('en-US', { month: 'short' }),
+      revenue: revenue._sum.totalAmount || 0,
+    })
+  }
+
+  return data
+}
+
+export async function getCategoryRevenue() {
+  const now = new Date()
+  const monthStart = startOfMonth(now)
+  const monthEnd = endOfMonth(now)
+
+  // Revenue by vehicle type + service (simplified for MVP)
+  const bikeRevenue = await prisma.order.aggregate({
+    where: {
+      status: 'PAID',
+      createdAt: {
+        gte: monthStart,
+        lte: monthEnd,
+      },
+    },
+    _sum: { totalAmount: true },
+  })
+
+  const totalRevenue = bikeRevenue._sum.totalAmount || 1
+
+  return [
+    { name: 'Bikes', value: totalRevenue * 0.6, percentage: 60 },
+    { name: 'Scooters', value: totalRevenue * 0.25, percentage: 25 },
+    { name: 'Parts', value: totalRevenue * 0.1, percentage: 10 },
+    { name: 'Service', value: totalRevenue * 0.05, percentage: 5 },
+  ]
+}
+
+export async function getLowStockParts() {
+  const parts = await prisma.part.findMany({
+    where: {
+      quantity: {
+        lt: prisma.part.fields.minStock, // quantity < minStock
+      },
+    },
+    orderBy: { quantity: 'asc' },
+    take: 10,
+  })
+
+  return parts.map((part) => ({
+    id: part.id,
+    name: part.partName,
+    sku: part.sku,
+    stock: part.quantity,
+    minStock: part.minStock,
+  }))
+}
+
+export async function getRecentAppointments() {
+  const appointments = await prisma.appointment.findMany({
+    orderBy: { createdAt: 'desc' },
+    take: 5,
+    select: {
+      id: true,
+      clientUsername: true,
+      preferredDate: true,
+      status: true,
+      customService: true,
+      services: {
+        select: { service: true },
+      },
+    },
+  })
+
+  return appointments.map((apt) => ({
+    id: apt.id,
+    customerName: apt.clientUsername,
+    date: apt.preferredDate.toISOString().split('T')[0],
+    status: apt.status,
+    service: apt.customService || apt.services[0]?.service || 'General Service',
+  }))
+}
+```
